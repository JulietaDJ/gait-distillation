+def volumen_3d(model, x):
+    """Reproduce el forward interno del maestro hasta el volumen [B, G0, G1, G2, C]."""
+    feats = model.forward_backbone(x)
+    feats = model.backbone_projection(feats)
+    feats = feats + model.backbone_pos.unsqueeze(0).expand(feats.shape[0], -1, -1)
